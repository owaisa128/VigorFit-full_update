import React, { useState, useEffect } from 'react';
import { TrendingUp, Plus, Trash2, Calendar, Scale, Dumbbell, Award, AlertCircle, ArrowUpRight, ArrowDownRight, Activity } from 'lucide-react';
import api from '../api/axios';

export default function Progress() {
  const [logs, setLogs] = useState([]);
  const [summary, setSummary] = useState({
    currentWeight: 0,
    startWeight: 0,
    weightChange: 0,
    maxBench: 0,
    maxSquat: 0,
    maxDeadlift: 0,
    totalLogs: 0,
  });
  const [loading, setLoading] = useState(true);

  // Modal State
  const [showModal, setShowModal] = useState(false);
  const [formData, setFormData] = useState({
    date: new Date().toISOString().split('T')[0],
    weight: '',
    chest: '',
    waist: '',
    hips: '',
    biceps: '',
    thighs: '',
    bodyFatPercentage: '',
    benchPressMax: '',
    squatMax: '',
    deadliftMax: '',
    notes: '',
  });
  const [formError, setFormError] = useState('');
  const [submitting, setSubmitting] = useState(false);

  const fetchProgressData = async () => {
    setLoading(true);
    try {
      const [logsRes, summaryRes] = await Promise.all([
        api.get('/progress'),
        api.get('/progress/summary')
      ]);

      if (logsRes.data.success) {
        setLogs(logsRes.data.progress || []);
      }
      if (summaryRes.data.success) {
        setSummary(summaryRes.data.summary);
      }
    } catch (err) {
      console.error('Error loading progress data:', err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchProgressData();
  }, []);

  const handleFormSubmit = async (e) => {
    e.preventDefault();
    if (!formData.weight || Number(formData.weight) <= 0) {
      setFormError('Please enter a valid weight');
      return;
    }

    setSubmitting(true);
    setFormError('');

    try {
      await api.post('/progress', formData);
      setShowModal(false);
      setFormData({
        date: new Date().toISOString().split('T')[0],
        weight: '',
        chest: '',
        waist: '',
        hips: '',
        biceps: '',
        thighs: '',
        bodyFatPercentage: '',
        benchPressMax: '',
        squatMax: '',
        deadliftMax: '',
        notes: '',
      });
      fetchProgressData();
    } catch (err) {
      setFormError(err.response?.data?.message || 'Failed to record progress log');
    } finally {
      setSubmitting(false);
    }
  };

  const handleDelete = async (id) => {
    if (!window.confirm('Are you sure you want to delete this progress log?')) return;
    try {
      await api.delete(`/progress/${id}`);
      fetchProgressData();
    } catch (err) {
      console.error('Delete progress error:', err);
    }
  };

  // Helper for responsive SVG Weight Progress Chart
  const renderWeightChart = () => {
    if (logs.length < 2) {
      return (
        <div className="h-48 flex items-center justify-center text-xs text-gray-500 border border-dashed border-white/10 rounded-xl">
          Log at least 2 entries to generate your visual progress curve!
        </div>
      );
    }

    const weights = logs.map((l) => l.weight);
    const minW = Math.min(...weights) - 2;
    const maxW = Math.max(...weights) + 2;
    const range = maxW - minW || 1;

    const width = 600;
    const height = 180;

    const points = logs.map((log, index) => {
      const x = (index / (logs.length - 1)) * (width - 40) + 20;
      const y = height - ((log.weight - minW) / range) * (height - 40) - 20;
      return { x, y, weight: log.weight, date: log.date };
    });

    const svgPath = points.reduce((acc, point, i) => (
      i === 0 ? `M ${point.x} ${point.y}` : `${acc} L ${point.x} ${point.y}`
    ), '');

    return (
      <div className="w-full overflow-x-auto">
        <svg viewBox={`0 0 ${width} ${height}`} className="w-full h-48 overflow-visible">
          {/* Gradient Fill */}
          <defs>
            <linearGradient id="weightGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stopColor="#FF009D" stopOpacity="0.4" />
              <stop offset="100%" stopColor="#FF009D" stopOpacity="0.0" />
            </linearGradient>
          </defs>

          {/* Background Area */}
          <path
            d={`${svgPath} L ${points[points.length - 1].x} ${height} L ${points[0].x} ${height} Z`}
            fill="url(#weightGrad)"
          />

          {/* Stroke Line */}
          <path d={svgPath} fill="none" stroke="#FF009D" strokeWidth="3" strokeLinecap="round" />

          {/* Data Points */}
          {points.map((pt, i) => (
            <g key={i} className="group cursor-pointer">
              <circle cx={pt.x} cy={pt.y} r="5" fill="#0F0F14" stroke="#FF009D" strokeWidth="3" />
              <text
                x={pt.x}
                y={pt.y - 10}
                fill="#FFFFFF"
                fontSize="10"
                textAnchor="middle"
                className="font-bold opacity-0 group-hover:opacity-100 transition-opacity"
              >
                {pt.weight}kg
              </text>
            </g>
          ))}
        </svg>
      </div>
    );
  };

  return (
    <div className="min-h-screen bg-[#050505] text-white py-8 px-4 sm:px-6 lg:px-8">
      <div className="max-w-6xl mx-auto space-y-8">

        {/* Header Bar */}
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-[#0F0F14] border border-[#FF009D]/20 p-6 rounded-2xl shadow-xl">
          <div>
            <h1 className="text-2xl sm:text-3xl font-extrabold tracking-tight flex items-center gap-2">
              <TrendingUp className="w-8 h-8 text-[#FF009D]" />
              Fitness Progress & Body Metrics
            </h1>
            <p className="text-sm text-gray-400 mt-1">Track body weight changes, body measurements, and 1RM strength PRs</p>
          </div>

          <button
            onClick={() => setShowModal(true)}
            className="flex items-center gap-2 px-5 py-2.5 bg-[#FF009D] hover:bg-[#E0008A] text-white font-semibold rounded-xl shadow-[0_0_20px_rgba(255,0,157,0.4)] transition-all transform hover:scale-105 self-start sm:self-auto"
          >
            <Plus className="w-5 h-5" />
            <span>Log Progress</span>
          </button>
        </div>

        {/* Summary Metric Cards */}
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          
          {/* Current Weight */}
          <div className="bg-[#0F0F14] border border-[#FF009D]/30 p-5 rounded-2xl">
            <div className="flex items-center justify-between mb-2">
              <span className="text-xs font-bold text-gray-400 uppercase tracking-wider">Current Weight</span>
              <Scale className="w-5 h-5 text-[#FF009D]" />
            </div>
            <div className="flex items-baseline gap-1">
              <span className="text-3xl font-extrabold text-white">{summary.currentWeight || '--'}</span>
              <span className="text-xs text-gray-400">kg</span>
            </div>
            <div className="flex items-center gap-1 text-xs mt-2">
              {summary.weightChange <= 0 ? (
                <span className="text-emerald-400 flex items-center gap-0.5">
                  <ArrowDownRight className="w-4 h-4" /> {Math.abs(summary.weightChange)} kg
                </span>
              ) : (
                <span className="text-amber-400 flex items-center gap-0.5">
                  <ArrowUpRight className="w-4 h-4" /> +{summary.weightChange} kg
                </span>
              )}
              <span className="text-gray-500">overall change</span>
            </div>
          </div>

          {/* Bench Press Max */}
          <div className="bg-[#0F0F14] border border-blue-500/30 p-5 rounded-2xl">
            <div className="flex items-center justify-between mb-2">
              <span className="text-xs font-bold text-gray-400 uppercase tracking-wider">Bench Press PR</span>
              <Dumbbell className="w-5 h-5 text-blue-400" />
            </div>
            <div className="flex items-baseline gap-1">
              <span className="text-3xl font-extrabold text-blue-400">{summary.maxBench || 0}</span>
              <span className="text-xs text-gray-400">kg</span>
            </div>
            <p className="text-[11px] text-gray-500 mt-2">Personal Record</p>
          </div>

          {/* Squat Max */}
          <div className="bg-[#0F0F14] border border-emerald-500/30 p-5 rounded-2xl">
            <div className="flex items-center justify-between mb-2">
              <span className="text-xs font-bold text-gray-400 uppercase tracking-wider">Squat PR</span>
              <Award className="w-5 h-5 text-emerald-400" />
            </div>
            <div className="flex items-baseline gap-1">
              <span className="text-3xl font-extrabold text-emerald-400">{summary.maxSquat || 0}</span>
              <span className="text-xs text-gray-400">kg</span>
            </div>
            <p className="text-[11px] text-gray-500 mt-2">Personal Record</p>
          </div>

          {/* Deadlift Max */}
          <div className="bg-[#0F0F14] border border-purple-500/30 p-5 rounded-2xl">
            <div className="flex items-center justify-between mb-2">
              <span className="text-xs font-bold text-gray-400 uppercase tracking-wider">Deadlift PR</span>
              <Activity className="w-5 h-5 text-purple-400" />
            </div>
            <div className="flex items-baseline gap-1">
              <span className="text-3xl font-extrabold text-purple-400">{summary.maxDeadlift || 0}</span>
              <span className="text-xs text-gray-400">kg</span>
            </div>
            <p className="text-[11px] text-gray-500 mt-2">Personal Record</p>
          </div>

        </div>

        {/* Visual Progress Chart Container */}
        <div className="bg-[#0F0F14] border border-white/10 p-6 rounded-2xl space-y-4">
          <div className="flex items-center justify-between">
            <div>
              <h3 className="text-lg font-bold text-white flex items-center gap-2">
                <TrendingUp className="w-5 h-5 text-[#FF009D]" /> Weight Progress Chart
              </h3>
              <p className="text-xs text-gray-400">Historical trend curve across logged check-ins</p>
            </div>
            <span className="text-xs bg-white/5 border border-white/10 px-3 py-1 rounded-full text-gray-300">
              {summary.totalLogs} Logged Check-ins
            </span>
          </div>

          {renderWeightChart()}
        </div>

        {/* History Table */}
        <div className="bg-[#0F0F14] border border-white/10 rounded-2xl overflow-hidden">
          <div className="p-5 border-b border-white/10 flex items-center justify-between">
            <h3 className="text-base font-bold text-white">Historical Progress Records</h3>
          </div>

          {loading ? (
            <div className="p-12 text-center text-gray-400">
              <div className="inline-block animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-[#FF009D] mb-2"></div>
              <p className="text-xs">Loading progress records...</p>
            </div>
          ) : logs.length === 0 ? (
            <div className="p-12 text-center space-y-3">
              <Scale className="w-12 h-12 text-gray-600 mx-auto mb-1" />
              <h4 className="text-base font-bold text-gray-300">No Progress Records Yet</h4>
              <p className="text-xs text-gray-500 max-w-sm mx-auto">
                Start tracking your body weight and strength PRs over time!
              </p>
              <button
                onClick={() => setShowModal(true)}
                className="mt-2 inline-flex items-center gap-2 px-4 py-2 bg-[#FF009D] text-white text-xs font-semibold rounded-xl"
              >
                <Plus className="w-4 h-4" /> Log Progress
              </button>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full text-left text-xs text-gray-300">
                <thead className="bg-[#181824] text-gray-400 uppercase tracking-wider text-[10px]">
                  <tr>
                    <th className="py-3 px-4">Date</th>
                    <th className="py-3 px-4">Weight (kg)</th>
                    <th className="py-3 px-4">Body Fat %</th>
                    <th className="py-3 px-4">Waist / Chest</th>
                    <th className="py-3 px-4">Bench / Squat / DL</th>
                    <th className="py-3 px-4 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-white/5">
                  {logs.slice().reverse().map((log) => (
                    <tr key={log._id} className="hover:bg-white/[0.02] transition-colors">
                      <td className="py-3.5 px-4 font-semibold text-white flex items-center gap-1.5">
                        <Calendar className="w-3.5 h-3.5 text-[#FF009D]" />
                        {log.date}
                      </td>
                      <td className="py-3.5 px-4 font-extrabold text-[#FF009D]">{log.weight} kg</td>
                      <td className="py-3.5 px-4">{log.bodyFatPercentage ? `${log.bodyFatPercentage}%` : '--'}</td>
                      <td className="py-3.5 px-4 text-gray-400">
                        {log.waist ? `${log.waist}cm` : '--'} / {log.chest ? `${log.chest}cm` : '--'}
                      </td>
                      <td className="py-3.5 px-4 text-gray-300 font-medium">
                        {log.benchPressMax || '--'} / {log.squatMax || '--'} / {log.deadliftMax || '--'} kg
                      </td>
                      <td className="py-3.5 px-4 text-right">
                        <button
                          onClick={() => handleDelete(log._id)}
                          className="p-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg transition-colors"
                          title="Delete Record"
                        >
                          <Trash2 className="w-3.5 h-3.5" />
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>

        {/* Modal for Log Progress */}
        {showModal && (
          <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in">
            <div className="bg-[#0F0F16] border border-[#FF009D]/30 w-full max-w-xl rounded-2xl shadow-2xl p-6 relative max-h-[90vh] overflow-y-auto">
              <h3 className="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <TrendingUp className="w-5 h-5 text-[#FF009D]" />
                Log Fitness & Body Metrics
              </h3>

              {formError && (
                <div className="mb-4 bg-red-500/10 border border-red-500/30 p-3 rounded-xl flex items-center gap-2 text-xs text-red-300">
                  <AlertCircle className="w-4 h-4 text-red-400 shrink-0" />
                  <span>{formError}</span>
                </div>
              )}

              <form onSubmit={handleFormSubmit} className="space-y-4">
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="block text-xs font-semibold text-gray-400 mb-1">Date *</label>
                    <input
                      type="date"
                      value={formData.date}
                      onChange={(e) => setFormData({ ...formData, date: e.target.value })}
                      className="w-full bg-[#181824] border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF009D]"
                      required
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-semibold text-gray-400 mb-1">Body Weight (kg) *</label>
                    <input
                      type="number"
                      step="0.1"
                      placeholder="e.g. 72.5"
                      value={formData.weight}
                      onChange={(e) => setFormData({ ...formData, weight: e.target.value })}
                      className="w-full bg-[#181824] border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF009D]"
                      required
                    />
                  </div>
                </div>

                <div className="border-t border-white/10 pt-3">
                  <p className="text-xs font-bold text-gray-300 mb-3 uppercase tracking-wider">Body Measurements (cm)</p>
                  <div className="grid grid-cols-3 gap-3">
                    <div>
                      <label className="block text-[11px] text-gray-400 mb-1">Chest</label>
                      <input
                        type="number"
                        placeholder="cm"
                        value={formData.chest}
                        onChange={(e) => setFormData({ ...formData, chest: e.target.value })}
                        className="w-full bg-[#181824] border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF009D]"
                      />
                    </div>
                    <div>
                      <label className="block text-[11px] text-gray-400 mb-1">Waist</label>
                      <input
                        type="number"
                        placeholder="cm"
                        value={formData.waist}
                        onChange={(e) => setFormData({ ...formData, waist: e.target.value })}
                        className="w-full bg-[#181824] border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF009D]"
                      />
                    </div>
                    <div>
                      <label className="block text-[11px] text-gray-400 mb-1">Hips</label>
                      <input
                        type="number"
                        placeholder="cm"
                        value={formData.hips}
                        onChange={(e) => setFormData({ ...formData, hips: e.target.value })}
                        className="w-full bg-[#181824] border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF009D]"
                      />
                    </div>
                  </div>
                </div>

                <div className="border-t border-white/10 pt-3">
                  <p className="text-xs font-bold text-gray-300 mb-3 uppercase tracking-wider">Strength 1RMs (kg)</p>
                  <div className="grid grid-cols-3 gap-3">
                    <div>
                      <label className="block text-[11px] text-gray-400 mb-1">Bench Press</label>
                      <input
                        type="number"
                        placeholder="kg"
                        value={formData.benchPressMax}
                        onChange={(e) => setFormData({ ...formData, benchPressMax: e.target.value })}
                        className="w-full bg-[#181824] border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF009D]"
                      />
                    </div>
                    <div>
                      <label className="block text-[11px] text-gray-400 mb-1">Squat</label>
                      <input
                        type="number"
                        placeholder="kg"
                        value={formData.squatMax}
                        onChange={(e) => setFormData({ ...formData, squatMax: e.target.value })}
                        className="w-full bg-[#181824] border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF009D]"
                      />
                    </div>
                    <div>
                      <label className="block text-[11px] text-gray-400 mb-1">Deadlift</label>
                      <input
                        type="number"
                        placeholder="kg"
                        value={formData.deadliftMax}
                        onChange={(e) => setFormData({ ...formData, deadliftMax: e.target.value })}
                        className="w-full bg-[#181824] border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-[#FF009D]"
                      />
                    </div>
                  </div>
                </div>

                <div className="flex items-center justify-end gap-3 pt-4 border-t border-white/10">
                  <button
                    type="button"
                    onClick={() => setShowModal(false)}
                    className="px-4 py-2 bg-white/5 hover:bg-white/10 text-gray-300 rounded-xl text-xs"
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    disabled={submitting}
                    className="px-5 py-2 bg-[#FF009D] hover:bg-[#E0008A] text-white font-semibold rounded-xl text-xs disabled:opacity-50"
                  >
                    {submitting ? 'Saving...' : 'Save Log'}
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}
